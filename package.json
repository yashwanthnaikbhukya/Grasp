{
  "name": "grasp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @grasp/web dev",
    "build": "turbo run build",
    "check": "turbo run typecheck lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:check": "tsx scripts/setup-check.ts",
    "models:check": "tsx scripts/models-check.ts",
    "smoke": "tsx scripts/smoke.ts",
    "traces": "tsx scripts/traces.ts",
    "concepts:grow": "tsx scripts/concepts-grow.ts",
    "concepts:reset": "tsx scripts/concepts-reset.ts",
    "concepts:calibrate": "tsx scripts/concepts-calibrate.ts",
    "db:indexes": "tsx scripts/db-indexes.ts",
    "db:seed:concepts": "tsx scripts/seed-concepts.ts",
    "db:seed:curricula": "tsx scripts/seed-curricula.ts",
    "db:seed": "pnpm db:seed:curricula && pnpm db:seed:concepts",
    "eval": "tsx scripts/eval.ts"
  },
  "devDependencies": {
    "@grasp/core": "workspace:*",
    "@grasp/prompts": "workspace:*",
    "@grasp/schema": "workspace:*",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
