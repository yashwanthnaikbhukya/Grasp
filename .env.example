# =============================================================================
# Grasp environment
#
# Copy to .env.local and fill in. Run `pnpm setup:check` to see what's missing.
# Step-by-step instructions for every value: docs/08-setup.md
#
# PHASE 0 needs only the values marked [P0]. Everything else can stay blank
# until the phase that needs it — setup:check will tell you.
# =============================================================================

# --- Core ---------------------------------------------------------------- [P0]
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Content scope -------------------------------------------------------- [P0]
# The one narrow scope for the POC. Everything ingested and generated is
# filtered by this. See docs/01-product.md#scope
GRASP_BOARD=CBSE
GRASP_GRADE=10
GRASP_SUBJECT=Mathematics

# --- MongoDB Atlas -------------------------------------------------------- [P0]
# Atlas → Cluster → Connect → Drivers. Replace <password>, keep the db name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=grasp

# --- Models: at least ONE of these three is required --------------------- [P0]
# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_MID=gemini-2.0-flash
GEMINI_MODEL_FAST=gemini-2.0-flash-lite

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_MID=llama-3.3-70b-versatile

# OpenRouter — https://openrouter.ai/keys  (use ":free" model variants)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_MID=

# --- Embeddings + rerank: local via Ollama -------------------------------- [P0]
# `ollama pull nomic-embed-text` — free, no quota, nothing leaves your machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768
OLLAMA_CHAT_MODEL=llama3.2

# --- Tracing ------------------------------------------------------- [P0, opt.]
# Langfuse Cloud free tier. Blank = gateway logs to stdout instead.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Cost guard ----------------------------------------------------------- [P0]
# Per-user daily output-token ceiling. On breach, degrade to the cheap tier.
GRASP_DAILY_TOKEN_BUDGET=200000

# --- Redis: cache, rate limit, card pre-generation queue ------------------ [P1]
# Upstash → Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth ----------------------------------------------------------------- [P1]
# Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Object storage: attachments ------------------------------------------ [P1]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=grasp-uploads
R2_PUBLIC_BASE_URL=

# --- Durable jobs: ingestion, card pre-gen, study plan -------------------- [P1]
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Product analytics ---------------------------------------------------- [P2]
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Realtime: duel presence only (never game logic) ---------------------- [P4]
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_SECRET=

# --- Python AI service: parsing, sympy, psychometrics --------------------- [P3]
GRASP_AI_URL=
GRASP_AI_TOKEN=
